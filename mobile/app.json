{
  "expo": {
    "name": "Raspberry Lanes",
    "slug": "raspberry-lanes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "raspberry-lanes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000078"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tliggett.raspberrylanes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000078"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d6115f7-2e34-4800-a079-7d1394103844"
      }
    }
  }
}
